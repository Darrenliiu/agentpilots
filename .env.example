NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
AGENTPILOTS_ENCRYPTION_KEY=generate-a-long-random-string

# Canonical public site URL for share/invite links, password-reset emails, etc.
# Required in production and for the desktop app so links are never localhost.
NEXT_PUBLIC_SITE_URL=https://agentpilots.ai

# Stripe — Community Pro (flat base + extra seats). Products need a Managed
# Payments–eligible tax_code (e.g. txcd_10105002 AIaaS Business Use).
# Base: $29/mo or $290/yr (25 seats included). Extra seat: $5/mo or $50/yr.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
# STRIPE_PRICE_PRO_SEAT_MONTHLY=price_...
# STRIPE_PRICE_PRO_SEAT_YEARLY=price_...

# Optional pre-registered OAuth client for MCP connectors that do not support
# Dynamic Client Registration or Client ID Metadata Documents (e.g. Google).
# MCP_OAUTH_CLIENT_ID=
# MCP_OAUTH_CLIENT_SECRET=
# Per-connector overrides: MCP_OAUTH_CLIENT_ID_GOOGLE_DRIVE=...

# Desktop / local LLM (set automatically by Electron; useful for local testing)
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11435/v1
# LOCAL_LLM_STATUS_PATH=
# AGENTPILOTS_CLI_STATUS_PATH=
# AGENTPILOTS_CLAUDE_CLI_PATH=
# AGENTPILOTS_CODEX_CLI_PATH=
# AGENTPILOTS_DESKTOP=1

# Marketing download page — GitHub Releases / CDN installers
# NEXT_PUBLIC_DESKTOP_VERSION=0.1.5
# Optional overrides; if unset, defaults are:
#   Windows: https://github.com/Darrenliiu/agentpilots/releases/latest/download/AgentPilots-Setup-<version>.exe
#   Mac:     https://github.com/Darrenliiu/agentpilots/releases/latest/download/AgentPilots-<version>-arm64.dmg
# NEXT_PUBLIC_DESKTOP_WINDOWS_URL=https://github.com/Darrenliiu/agentpilots/releases/latest/download/AgentPilots-Setup-0.1.5.exe
# NEXT_PUBLIC_DESKTOP_MAC_URL=https://github.com/Darrenliiu/agentpilots/releases/latest/download/AgentPilots-0.1.5-arm64.dmg
# NEXT_PUBLIC_DESKTOP_GITHUB_REPO=Darrenliiu/agentpilots
