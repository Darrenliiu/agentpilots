NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
AGENTPILOTS_ENCRYPTION_KEY=generate-a-long-random-string

# Optional canonical site URL (password-reset emails, etc.)
# NEXT_PUBLIC_SITE_URL=https://agentpilots.ai

# Optional pre-registered OAuth client for MCP connectors that do not support
# Dynamic Client Registration or Client ID Metadata Documents (e.g. Google).
# MCP_OAUTH_CLIENT_ID=
# MCP_OAUTH_CLIENT_SECRET=
# Per-connector overrides: MCP_OAUTH_CLIENT_ID_GOOGLE_DRIVE=...

# Desktop / local LLM (set automatically by Electron; useful for local testing)
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11435/v1
# LOCAL_LLM_STATUS_PATH=
# AGENTPILOTS_DESKTOP=1

# Marketing download page — point at GitHub Releases / CDN installer
# NEXT_PUBLIC_DESKTOP_WINDOWS_URL=https://github.com/OWNER/REPO/releases/latest/download/AgentPilots-Setup-0.1.0.exe
# NEXT_PUBLIC_DESKTOP_VERSION=0.1.0
